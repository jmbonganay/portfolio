# Copy this file to .env.local for local development only.
# Do not commit .env.local. It is blocked by .gitignore.
# These are public frontend identifiers used by this Vite app.

VITE_WEB3FORMS_ACCESS_KEY=replace-with-your-web3forms-access-key
VITE_HCAPTCHA_SITE_KEY=replace-with-your-hcaptcha-site-key
VITE_GA4_MEASUREMENT_ID=replace-with-your-ga4-measurement-id

# Server-only. Add this in Vercel, not as a VITE_ variable.
MAKE_WEBHOOK_URL=https://hook.us2.make.com/your-webhook-id
MAKE_WEBHOOK_SECRET=optional-shared-secret-for-make-validation
