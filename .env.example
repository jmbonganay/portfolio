# Copy this file to .env.local for local development only.
# Do not commit .env.local. It is blocked by .gitignore.
# Public frontend identifiers used by this Vite app.

VITE_HCAPTCHA_SITE_KEY=replace-with-your-hcaptcha-site-key
# GA4 remains inactive until the visitor explicitly allows analytics.
VITE_GA4_MEASUREMENT_ID=replace-with-your-ga4-measurement-id

# Server-only. Never prefix these values with VITE_.
HCAPTCHA_SECRET_KEY=replace-with-your-hcaptcha-secret
UPSTASH_REDIS_REST_URL=replace-with-your-upstash-rest-url
UPSTASH_REDIS_REST_TOKEN=replace-with-your-upstash-rest-token
MAKE_WEBHOOK_URL=https://hook.us2.make.com/your-webhook-id
MAKE_WEBHOOK_SECRET=replace-with-your-make-webhook-api-key
